{
  "realm": "cloudforge",
  "enabled": true,
  "displayName": "CloudForge Dev",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 1800,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "tenant-user",
        "description": "Regular CloudForge tenant user"
      },
      {
        "name": "platform-admin",
        "description": "CloudForge platform administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cf-console",
      "name": "CloudForge Console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "http://localhost:8083/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8080",
        "http://localhost:8083"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "cf_account_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "cf_account_id",
            "claim.name": "cf_account_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cf-internal",
      "name": "CloudForge Internal Services",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "cf-internal-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "dev-user@cloudforge.io",
      "email": "dev-user@cloudforge.io",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "User",
      "attributes": {
        "cf_account_id": [
          "11111111-1111-4111-8111-111111111111"
        ]
      },
      "realmRoles": [
        "tenant-user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "devpassword",
          "temporary": false
        }
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "admin@cloudforge.io",
      "email": "admin@cloudforge.io",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "attributes": {
        "cf_account_id": [
          "22222222-2222-4222-8222-222222222222"
        ]
      },
      "realmRoles": [
        "platform-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "adminpassword",
          "temporary": false
        }
      ]
    }
  ]
}
